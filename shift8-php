#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

BASE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=lib/common.sh
source "$BASE_DIR/lib/common.sh"
# shellcheck source=lib/networking.sh
source "$BASE_DIR/lib/networking.sh"
# shellcheck source=lib/detect.sh
source "$BASE_DIR/lib/detect.sh"
# shellcheck source=lib/repositories.sh
source "$BASE_DIR/lib/repositories.sh"
# shellcheck source=lib/sources.sh
source "$BASE_DIR/lib/sources.sh"
# shellcheck source=lib/build-rpm.sh
source "$BASE_DIR/lib/build-rpm.sh"

usage() {
    cat <<'EOF'
shift8-php - read-only PHP package discovery and authenticated source preparation

Usage: shift8-php <discover|plan|prepare|environment|build|recovery|check> <installed-package> [options]
       shift8-php <deploy|rollback> <installed-package>

Options:
  --target=X.Y.Z          Select an officially published release in the same branch
  --artifact-dir=PATH     Private artifact store (default: /var/lib/shift8-php)
  --source-only          Retrieve sources even when a repository candidate exists
  --source-first         Plan from the installed contract; prepare only upstream PHP
  --source-map=PATH       Reviewed, checksum-pinned packaging file map
  --source-keyring=PATH   Trusted keyring for Debian source signatures
  --build-profile=PATH    Explicitly reviewed isolated mock build profile (EL7 Remi)
  --build-environment=PATH Reviewed source-first compiler/mock/private OpenSSL inputs
  --deployment-policy=PATH Reviewed recovery/service/application-health policy
  --environment-dir=PATH  New directory for the generated mock config and pinned OpenSSL (environment)
  --openssl-version=X.Y.Z Maintained OpenSSL 3.5 LTS release to build privately (environment)
  --jobs=N                Parallel build jobs for the generated environment (default: CPU count)
  --recovery-dir=PATH     New directory for signature-verified rollback RPMs (recovery command)
  --recovery-repos=IDS    Comma-separated repository ids to search for the exact installed RPMs
  --apply                Apply a managed deploy/rollback (default: transaction inspection)
  --manifest=PATH         Prepared manifest for read-only compatibility check
  --dry-run              Discover and plan; do not persist or download sources
  --offline              Use previously authenticated, unexpired cached inputs only
  --ipv4                 Force IPv4
  --verbose              Print phase diagnostics
  --yes                  Reserved; never authorizes deployment in this release
  --help                 Show this help

Build, deploy and rollback are disabled by default.
Build requires an explicitly reviewed --build-profile; deploy/rollback stay disabled.
No host toolchains, PHP packages, repositories or services are changed.
EOF
}

COMMAND=${1:-}
[[ $# -eq 0 ]] || shift
PACKAGE='' TARGET='' SOURCE_MAP='' SOURCE_KEYRING='' BUILD_PROFILE='' BUILD_ENVIRONMENT='' MANIFEST='' DEPLOYMENT_POLICY=''
APPLY=0 HOST_MUTATION_POSSIBLE=0 RECOVERY_DIR='' RECOVERY_REPOS='' ENVIRONMENT_DIR='' OPENSSL_VERSION='' BUILD_JOBS=''
ARTIFACT_DIR=/var/lib/shift8-php
DRY_RUN=0 OFFLINE=0 IPV4=0 VERBOSE=0 SOURCE_ONLY=0 SOURCE_FIRST=0
WORK='' LOG_FILE='' OPERATION=initialization BUILD_PID=''
trap cleanup EXIT
trap 'failed "$?" "$LINENO"' ERR
trap 'die 130 "Interrupted; source preparation may be incomplete. Re-run to revalidate inputs."' INT
trap 'die 143 "Terminated; source preparation may be incomplete. Re-run to revalidate inputs."' TERM

case "$COMMAND" in
    -h | --help | '')
        usage
        exit 0
        ;;
    discover | plan | prepare | environment | build | recovery | check | deploy | rollback) ;;
    *) die 2 "Unknown command: $COMMAND" ;;
esac
for argument in "$@"; do
    case "$argument" in
        --target=*)
            TARGET=${argument#*=}
            [[ -n $TARGET ]] || die 2 "Target must not be empty."
            ;;
        --artifact-dir=*) ARTIFACT_DIR=${argument#*=} ;;
        --environment-dir=*) ENVIRONMENT_DIR=${argument#*=} ;;
        --openssl-version=*) OPENSSL_VERSION=${argument#*=} ;;
        --jobs=*) BUILD_JOBS=${argument#*=} ;;
        --recovery-dir=*) RECOVERY_DIR=${argument#*=} ;;
        --recovery-repos=*) RECOVERY_REPOS=${argument#*=} ;;
        --source-map=*)
            SOURCE_MAP=${argument#*=}
            [[ -n $SOURCE_MAP ]] || die 2 "Source map path must not be empty."
            ;;
        --source-keyring=*)
            SOURCE_KEYRING=${argument#*=}
            [[ -n $SOURCE_KEYRING ]] || die 2 "Source keyring path must not be empty."
            ;;
        --build-profile=*)
            BUILD_PROFILE=${argument#*=}
            [[ -n $BUILD_PROFILE ]] || die 2 "Build profile path must not be empty."
            SOURCE_ONLY=1
            ;;
        --manifest=*)
            MANIFEST=${argument#*=}
            [[ -n $MANIFEST ]] || die 2 "Manifest path must not be empty."
            ;;
        --build-environment=*) BUILD_ENVIRONMENT=${argument#*=} ;;
        --deployment-policy=*) DEPLOYMENT_POLICY=${argument#*=} ;;
        --apply) APPLY=1 ;;
        --dry-run) DRY_RUN=1 ;;
        --offline) OFFLINE=1 ;;
        --ipv4) IPV4=1 ;;
        --verbose) VERBOSE=1 ;;
        --source-only) SOURCE_ONLY=1 ;;
        --source-first) SOURCE_FIRST=1 SOURCE_ONLY=1 ;;
        --yes) ;;
        --rollback) COMMAND=rollback ;;
        --build-only | --force-rebuild | --allow-prerelease)
            die 2 "$argument is not supported in milestones 1-3; only stable source preparation is available."
            ;;
        --help)
            usage
            exit 0
            ;;
        -*) die 2 "Unknown option: $argument" ;;
        *)
            [[ -z $PACKAGE ]] || die 2 "Supply exactly one installed package identifier."
            PACKAGE=$argument
            ;;
    esac
done
[[ $PACKAGE =~ ^[a-zA-Z0-9][a-zA-Z0-9.+:_-]*$ ]] || die 2 "A valid, exact installed package identifier is required."
if [[ $COMMAND == deploy || $COMMAND == rollback ]]; then
    [[ -n $DEPLOYMENT_POLICY && -f $DEPLOYMENT_POLICY ]] ||
        die 3 "$COMMAND is disabled without a reviewed --deployment-policy and complete validated recovery."
    [[ -z $BUILD_PROFILE && -z $BUILD_ENVIRONMENT && -z $TARGET && $SOURCE_FIRST -eq 0 ]] ||
        die 2 "Managed deployment does not accept build/target/source-first options."
    (( !DRY_RUN || !APPLY )) || die 2 "--dry-run cannot be combined with --apply."
    if [[ $COMMAND == deploy ]]; then
        [[ -n $MANIFEST && -f $MANIFEST ]] || die 2 "deploy requires a verified build --manifest."
    fi
elif [[ -n $DEPLOYMENT_POLICY || $APPLY -eq 1 ]]; then
    die 2 "Deployment policies and --apply are only valid with deploy or rollback."
fi
[[ -z $TARGET || $TARGET =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 2 "Target must be a stable X.Y.Z version."
[[ -n $ARTIFACT_DIR ]] || die 2 "Artifact directory must not be empty."
if [[ $COMMAND == plan ]]; then SOURCE_FIRST=1 DRY_RUN=1; fi
if ((SOURCE_FIRST)); then
    [[ $COMMAND == plan || $COMMAND == discover || $COMMAND == prepare ]] ||
        die 2 "--source-first is only valid with discover, plan or prepare."
    [[ -z $BUILD_PROFILE && -z $SOURCE_MAP && -z $SOURCE_KEYRING ]] ||
        die 2 "--source-first does not accept historical packaging maps/keyrings or vendor build profiles."
fi
for dependency in mktemp tar; do
    require "$dependency"
done
select_metadata_python
if [[ $COMMAND == recovery ]]; then
    [[ -n $RECOVERY_DIR && ! -e $RECOVERY_DIR ]] || die 2 "recovery requires a new --recovery-dir that does not exist yet."
    [[ $SOURCE_FIRST -eq 0 && -z $TARGET && -z $MANIFEST ]] || die 2 "recovery accepts only the package, --recovery-dir and --recovery-repos."
    require rpm
    require curl
    SOURCE_FIRST=1
elif [[ -n $RECOVERY_DIR || -n $RECOVERY_REPOS ]]; then
    die 2 "--recovery-dir/--recovery-repos are only valid with recovery."
fi
if [[ $COMMAND == environment ]]; then
    [[ -n $ENVIRONMENT_DIR && ! -e $ENVIRONMENT_DIR && -n $OPENSSL_VERSION ]] ||
        die 2 "environment requires a new --environment-dir and an explicit --openssl-version."
    [[ $SOURCE_FIRST -eq 0 && -z $TARGET && -z $MANIFEST ]] || die 2 "environment accepts only package, directory, OpenSSL version and jobs."
    require curl
    SOURCE_FIRST=1
elif [[ -n $ENVIRONMENT_DIR || -n $OPENSSL_VERSION || -n $BUILD_JOBS ]]; then
    die 2 "--environment-dir/--openssl-version/--jobs are only valid with environment."
fi
if [[ $COMMAND == build ]]; then
    [[ -n $MANIFEST && -f $MANIFEST && -n $BUILD_ENVIRONMENT && -f $BUILD_ENVIRONMENT ]] ||
        die 2 "build requires a verified --manifest and reviewed --build-environment."
    [[ -z $BUILD_PROFILE && -z $SOURCE_MAP && -z $TARGET ]] ||
        die 2 "Source-first build uses the prepared target, not vendor profiles, maps or a new target."
    ((!DRY_RUN && !OFFLINE)) || die 2 "Use plan for inspection; offline/dry-run source builds are not supported."
    require mock
    require rpm
    require setsid
    require flock
    WORK=$(mktemp -d "${TMPDIR:-/tmp}/shift8-php.XXXXXXXX")
    ARTIFACT_DIR=$(meta store "$ARTIFACT_DIR")
    exec 9>>"$ARTIFACT_DIR/.prepare.lock"
    flock -n 9 || die 4 "Another operation is using this artifact store."
    BUILD_DIR=$(mktemp -d "$ARTIFACT_DIR/builds/source-build.XXXXXXXX")
    rmdir "$BUILD_DIR"
    "${METADATA_PYTHON}" "$BASE_DIR/lib/source_build.py" initialize "$MANIFEST" "$PACKAGE" "$BUILD_DIR"
    LOG_FILE=$BUILD_DIR/preparation.log
    BUILD_PROFILE=$("${METADATA_PYTHON}" "$BASE_DIR/lib/source_build.py" \
        "$BUILD_DIR/manifest.json" "$BUILD_ENVIRONMENT" "$BUILD_DIR/source-inputs")
    rm -- "$BUILD_DIR/manifest.json"
    OPERATION=source-build
    build_rpm
    meta manifest "$BUILD_DIR" isolated-rpm-build
    meta verify-manifest "$BUILD_DIR/manifest.json"
    log "Source-first RPM artifacts built. Signing, native target validation and deployment approval remain mandatory."
    printf '%s\n' "$BUILD_DIR/manifest.json"
    exit 0
elif [[ -n $BUILD_ENVIRONMENT ]]; then
    die 2 "--build-environment is only valid with build."
fi
if [[ $COMMAND == rollback ]]; then
    if ((APPLY)); then HOST_MUTATION_POSSIBLE=1; fi
    OPERATION=managed-rollback
    "${METADATA_PYTHON}" "$BASE_DIR/lib/deployment_cli.py" rollback "$PACKAGE" "" "" "$DEPLOYMENT_POLICY" "$APPLY"
    exit 0
fi
if [[ $COMMAND == check ]]; then
    [[ -n $MANIFEST ]] || die 2 "check requires --manifest pointing to a prepared build."
elif [[ -n $MANIFEST && $COMMAND != deploy && $COMMAND != rollback ]]; then
    die 2 "--manifest is only valid with check."
fi
if [[ -n $BUILD_PROFILE ]]; then
    [[ $COMMAND == prepare ]] || die 2 "--build-profile is only valid with prepare."
    if [[ ! -f $BUILD_PROFILE ]]; then
        if [[ $BUILD_PROFILE == /absolute/path/to/profile.json || $BUILD_PROFILE == /absolute/reviewed/profile.json ]]; then
            die 2 "Build profile path is still a documentation placeholder: $BUILD_PROFILE. Replace it with a real local profile path, or omit --build-profile to prepare sources without starting an isolated build."
        fi
        die 2 "Build profile does not exist: $BUILD_PROFILE. Supply a real local profile path, or omit --build-profile to prepare sources without starting an isolated build."
    fi
    if ((!DRY_RUN)); then
        require mock
        require rpm
        require setsid
        ((!OFFLINE)) || die 3 "Offline isolated builds require authenticated buildroot caching, which is not implemented."
    fi
fi
WORK=$(mktemp -d "${TMPDIR:-/tmp}/shift8-php.XXXXXXXX")
LOG_FILE=$WORK/discovery.log
if [[ $COMMAND == prepare ]] && ((!DRY_RUN)); then
    require flock
    ARTIFACT_DIR=$(meta store "$ARTIFACT_DIR")
    exec 9>>"$ARTIFACT_DIR/.prepare.lock"
    flock -n 9 || die 4 "Another preparation is using this artifact store."
    LOG_FILE=$ARTIFACT_DIR/logs/preparation-$(date -u +%Y%m%dT%H%M%SZ)-$$.log
    : >"$LOG_FILE"
fi
OPERATION=discovery
discover
if [[ $COMMAND == deploy || $COMMAND == rollback ]]; then
    if ((APPLY)); then HOST_MUTATION_POSSIBLE=1; fi
    OPERATION=managed-$COMMAND
    "${METADATA_PYTHON}" "$BASE_DIR/lib/deployment_cli.py" "$COMMAND" "$PACKAGE" "$MANIFEST" \
        "$WORK/discovery.json" "$DEPLOYMENT_POLICY" "$APPLY"
    exit 0
fi
if [[ $COMMAND == environment ]]; then
    : "${BUILD_JOBS:=$(getconf _NPROCESSORS_ONLN)}"
    "${METADATA_PYTHON}" "$BASE_DIR/lib/environment_setup.py" "$WORK/discovery.json" "$ENVIRONMENT_DIR" "$OPENSSL_VERSION" "$BUILD_JOBS"
    exit 0
fi
if [[ $COMMAND == recovery ]]; then
    "${METADATA_PYTHON}" "$BASE_DIR/lib/recovery.py" "$WORK/discovery.json" "$RECOVERY_DIR" "$RECOVERY_REPOS"
    log "Recovery RPMs verified in $RECOVERY_DIR; reference this directory from the deployment policy."
    exit 0
fi
if [[ $COMMAND == discover ]]; then
    cat "$WORK/discovery.json"
    exit 0
fi
if [[ $COMMAND == check ]]; then
    meta compare "$WORK/discovery.json" "$MANIFEST"
    exit 0
fi
if ((!OFFLINE)); then require curl; fi
OPERATION='release-selection'
select_release
if ((SOURCE_FIRST)); then
    source_meta plan "$WORK/discovery.json" "$WORK/release.json" >"$WORK/source-plan.json"
    if [[ $COMMAND == plan ]] || ((DRY_RUN)); then
        cat "$WORK/source-plan.json"
        log "Source-first contract only: no historical packaging queries, compilation or deployment. Inspect blockers and required_checks."
        exit 0
    fi
    BUILD_ID=$(meta build-id "$WORK/discovery.json" "$WORK/release.json")
    BUILD_DIR=$(mktemp -d "$ARTIFACT_DIR/builds/$BUILD_ID.XXXXXXXX")
    cp "$WORK/discovery.json" "$WORK/release.json" "$WORK/source-plan.json" "$BUILD_DIR/"
    cp "$WORK/support.json" "$WORK/releases.json" "$WORK/support.json.receipt.json" \
        "$WORK/releases.json.receipt.json" "$BUILD_DIR/"
    printf '%s\n' '{"candidates":[],"preferred_route":"source-first","queried":false}' >"$BUILD_DIR/repositories.json"
    cp "$LOG_FILE" "$BUILD_DIR/preparation.log"
    LOG_FILE=$BUILD_DIR/preparation.log
    acquire_upstream
    printf '%s\n' upstream-only-installed-contract-not-vendor-packaging >"$BUILD_DIR/sources/packaging-trust"
    meta manifest "$BUILD_DIR" source-preparation
    meta verify-manifest "$BUILD_DIR/manifest.json"
    log "Authenticated upstream source and installed contract prepared. No build or replacement was performed."
    log "Next: inspect source-plan.json, then run environment and build with this manifest."
    printf '%s\n' "$BUILD_DIR/manifest.json"
    exit 0
fi
if [[ -n $BUILD_PROFILE ]]; then
    build_meta validate "$BUILD_PROFILE" "$WORK/discovery.json" "$WORK/release.json"
fi
OPERATION='repository-discovery'
query_repositories
if ((DRY_RUN)); then
    meta plan "$WORK/discovery.json" "$WORK/release.json" "$WORK/repositories.json"
    exit 0
fi
BUILD_ID=$(meta build-id "$WORK/discovery.json" "$WORK/release.json")
BUILD_DIR=$(mktemp -d "$ARTIFACT_DIR/builds/$BUILD_ID.XXXXXXXX")
cp "$WORK/discovery.json" "$WORK/release.json" "$WORK/repositories.json" "$BUILD_DIR/"
cp "$WORK/support.json" "$WORK/releases.json" "$WORK/support.json.receipt.json" \
    "$WORK/releases.json.receipt.json" "$BUILD_DIR/"
cp "$LOG_FILE" "$BUILD_DIR/preparation.log"
LOG_FILE=$BUILD_DIR/preparation.log
if ((!SOURCE_ONLY)) && [[ $(meta get "$WORK/repositories.json" preferred_route) == native-package-review ]]; then
    meta manifest "$BUILD_DIR" native-update-review
    meta verify-manifest "$BUILD_DIR/manifest.json"
    log "Native repository candidate found; signature, advisory and transaction review are still required."
    log "No sources downloaded. Use --source-only to explicitly investigate a rebuild instead."
    printf '%s\n' "$BUILD_DIR/manifest.json"
    exit 0
fi
OPERATION='source-acquisition'
acquire_sources
if [[ -n $BUILD_PROFILE ]]; then
    OPERATION='isolated-build'
    build_rpm
fi
OPERATION='manifest-validation'
if [[ -n $BUILD_PROFILE ]]; then
    meta manifest "$BUILD_DIR" isolated-rpm-build
else
    meta manifest "$BUILD_DIR" source-preparation
fi
meta verify-manifest "$BUILD_DIR/manifest.json"
if [[ -n $BUILD_PROFILE ]]; then
    log "Prepared statically inspected isolated build artifacts: $BUILD_DIR/manifest.json"
else
    log "Prepared source inputs only: $BUILD_DIR/manifest.json"
fi
log "Not build-ready or deployable; package/runtime compatibility remains unverified."
printf '%s\n' "$BUILD_DIR/manifest.json"
